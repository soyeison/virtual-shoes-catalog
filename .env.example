# Copia este archivo a .env y completa los secretos: cp .env.example .env
# docker compose lee el .env automáticamente para reemplazar las ${VARIABLES} de docker-compose.yml.
# El .env está en .gitignore: nunca lo subas al repositorio.

# --- Secretos (obligatorios: docker compose no arranca si falta alguno) ---
# Genera cada valor con: openssl rand -hex 20
# Credenciales de RustFS; el compose las reparte a storage, storage-setup y api
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Firma de los JWT de la API
JWT_SECRET_KEY=
# Clave del administrador de Jenkins
JENKINS_ADMIN_PASSWORD=

# --- Configuración (opcional: si se omite se usa el valor indicado) ---
JENKINS_ADMIN_USER=admin
S3_BUCKET=catalogo-images
S3_REGION=us-east-1
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Puertos del host (las URLs que usan el navegador y CORS se arman con ellos)
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=4321
JENKINS_PORT=8081
JENKINS_AGENT_PORT=50000
