---
interface Props {
  src: string;
  alt: string;
  className?: string;
}
const { src, alt, className } = Astro.props;
---

<div class={`overflow-hidden rounded-xl bg-neutral-800 ${className}`}>
  <img
    src={src}
    alt={alt}
    class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
    loading="lazy"
  />
</div>
