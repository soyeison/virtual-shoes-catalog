---
import "../../styles/global.css";
import { CartWidget } from "../../modules/cart/components/CartWidget";
import { CartSidebar } from "../../modules/cart/components/CartSidebar";
import { AuthWidget } from "../../modules/auth/components/AuthWidget";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "NovaRun - Catálogo virtual de calzado deportivo",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="bg-[#0f0f0f] text-white font-['Urbanist'] min-h-screen flex flex-col"
  >
    <header class="border-b border-neutral-800 bg-[#121212] sticky top-0 z-50">
      <div
        class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between"
      >
        <a href="/" class="text-3xl font-black tracking-tighter">
          NOVA<span class="text-orange-500">RUN</span>
        </a>

        <nav
          class="hidden md:flex gap-8 text-sm font-bold uppercase tracking-widest text-neutral-400"
        >
          <a href="/" class="text-white hover:text-orange-500 transition-colors"
            >Catálogo</a
          >
        </nav>

        <div class="flex items-center gap-6">
          <AuthWidget client:load />

          <CartWidget client:load />
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <CartSidebar client:load />

    <footer
      class="border-t border-neutral-800 bg-[#121212] py-8 mt-12 text-center text-neutral-500 text-sm"
    >
      <p>
        &copy; {new Date().getFullYear()} NovaRun. Arquitectura Hexagonal en acción.
      </p>
    </footer>
  </body>
</html>
