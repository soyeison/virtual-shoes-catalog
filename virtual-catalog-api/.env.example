# Copia este archivo a .env y completa los valores: cp .env.example .env
# Todas las variables son obligatorias (excepto STRIPE_SECRET_KEY si no usas Stripe).
# Al usar docker compose desde la raíz, las variables S3_*, JWT_* y CORS_ORIGINS
# las define el compose a partir del .env de la raíz (ver ../.env.example).

# Ruta del archivo SQLite. Si es relativa se resuelve desde virtual-catalog-api/,
# así sirve igual en local y en Docker (el volumen se monta en data/). Ej: data/catalogo.db
DATABASE_PATH=

# Orígenes permitidos por CORS, como lista JSON. Ej: ["http://localhost:4321"]
CORS_ORIGINS=

# Almacenamiento de imágenes compatible con S3 (RustFS en docker-compose.yml)
# URL que usa la API para conectarse al almacenamiento
S3_ENDPOINT=
# URL base con la que el navegador descarga las imágenes subidas
S3_PUBLIC_URL=
# Credenciales y bucket. Al ejecutar la API fuera de Docker, usa los mismos valores que
# STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY y S3_BUCKET del .env de la raíz
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Región que exige boto3; RustFS acepta cualquiera. Ej: us-east-1
S3_REGION=

# Firma de los JWT. Genera el secreto con: openssl rand -hex 32
JWT_SECRET_KEY=
# Ej: HS256
JWT_ALGORITHM=
# Minutos de validez del token. Ej: 60
JWT_EXPIRATION_MINUTES=

# Proveedor de pagos: "mock" o "stripe"
PAYMENT_GATEWAY_PROVIDER=
# Clave secreta de Stripe (solo si PAYMENT_GATEWAY_PROVIDER=stripe)
STRIPE_SECRET_KEY=
