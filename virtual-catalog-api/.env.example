# Copia este archivo a .env y completa los valores: cp .env.example .env
# Todas las variables son obligatorias (excepto STRIPE_SECRET_KEY si no usas Stripe).
# Al usar docker compose desde la raíz, las variables de red de Docker
# (MINIO_ENDPOINT, MINIO_PUBLIC_URL, CORS_ORIGINS) se sobrescriben allí.

# Ruta del archivo SQLite. Si es relativa se resuelve desde virtual-catalog-api/,
# así sirve igual en local y en Docker (el volumen se monta en data/). Ej: data/catalogo.db
DATABASE_PATH=

# Orígenes permitidos por CORS, como lista JSON. Ej: ["http://localhost:4321"]
CORS_ORIGINS=

# URL que usa la API para conectarse a MinIO
MINIO_ENDPOINT=
# URL base con la que el navegador descarga las imágenes subidas
MINIO_PUBLIC_URL=
# Credenciales y bucket de MinIO (deben coincidir con docker-compose.yml)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Proveedor de pagos: "mock" o "stripe"
PAYMENT_GATEWAY_PROVIDER=
# Clave secreta de Stripe (solo si PAYMENT_GATEWAY_PROVIDER=stripe)
STRIPE_SECRET_KEY=
